# ==========================================
# OpenRouter Configuration
# ==========================================
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model slug (e.g., anthropic/claude-3.5-sonnet, openai/gpt-4o-mini, google/gemini-2.5-flash)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ==========================================
# Signal Bot Configuration
# ==========================================
# The phone number registered with signal-cli (include country code, e.g. +15551234567)
SIGNAL_PHONE_NUMBER=+15551234567

# URL of the signal-cli-rest-api instance
SIGNAL_API_URL=http://signal-cli:8080

# The trigger phrase at the start of a message
TRIGGER_PREFIX=@AI

# Number of past messages to keep in memory for group context
MAX_CONTEXT_MESSAGES=10

# Stale message threshold in seconds. Messages older than this (e.g. sent when laptop was offline)
# will be recorded to memory but will NOT trigger an AI response.
STALE_MESSAGE_THRESHOLD_SECONDS=120

# System prompt persona for the AI in your family group
SYSTEM_PROMPT=You are a helpful, friendly, and concise AI assistant participating in a family Signal group chat. You are aware of the conversation context. Keep answers punchy, natural, and easy to read on mobile. Avoid unnecessary fluff unless asked for detailed explanations.

# ==========================================
# Optional: Family Member Name Mapping (JSON)
# ==========================================
# Maps Signal UUIDs or phone numbers to friendly names for better context.
# Example: FAMILY_NAME_MAP={"uuid-or-phone-1": "Dad", "uuid-or-phone-2": "Mom"}
FAMILY_NAME_MAP={}
